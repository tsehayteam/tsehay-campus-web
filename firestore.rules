rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if request is from any authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is an authorized Tsehay Campus Admin
    function isGlobalAdmin() {
      return request.auth != null && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email in [
          'admin@tsehaycampus.com',
          'tsehayoperation@gmail.com',
          'eyoubsahle@gmail.com',
          'habte@gmail.com',
          'cryptomaster758@gmail.com'
        ])
      );
    }

    // 1. Root Courses Collection (Public Read, Admin/Authenticated Write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();

      match /{sub=**} {
        allow read: if true;
        allow write: if isGlobalAdmin() || isAuthenticated();
      }
    }
    
    // 2. Root Site Settings Collection
    match /site_settings/{settingKey} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();

      match /{sub=**} {
        allow read: if true;
        allow write: if isGlobalAdmin() || isAuthenticated();
      }
    }

    // 3. Root Users Collection (Users have full access to their own document & subcollections)
    match /users/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isGlobalAdmin();
      allow create: if isAuthenticated() || isGlobalAdmin();
      
      match /enrollments/{courseId} {
        allow read: if (isAuthenticated() && request.auth.uid == userId) || isGlobalAdmin();
        allow write: if isGlobalAdmin() || isAuthenticated();
      }

      match /{sub=**} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isGlobalAdmin();
      }
    }

    // 4. Root Community Posts, Comments & Direct Messaging
    match /community_posts/{postId} {
      allow read: if true;
      allow write: if isAuthenticated() || isGlobalAdmin();

      match /{sub=**} {
        allow read: if true;
        allow write: if isAuthenticated() || isGlobalAdmin();
      }
    }

    match /community_conversations/{convId} {
      allow read, write: if isAuthenticated() || isGlobalAdmin();

      match /{sub=**} {
        allow read, write: if isAuthenticated() || isGlobalAdmin();
      }
    }

    match /direct_messages/{msgId} {
      allow read, write: if isAuthenticated() || isGlobalAdmin();
    }

    // 5. Root Instructors Collection
    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();

      match /{sub=**} {
        allow read: if true;
        allow write: if isGlobalAdmin() || isAuthenticated();
      }
    }

    // 6. Root Student Feedback Collections
    match /user_feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isGlobalAdmin() || isAuthenticated();
    }

    match /student_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isGlobalAdmin() || isAuthenticated();
    }

    // 7. Root Events & Event Registrations (Public Read & Registration Create)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();

      match /{sub=**} {
        allow read: if true;
        allow write: if isGlobalAdmin() || isAuthenticated();
      }
    }

    match /event_registrations/{regId} {
      allow read, create: if true;
      allow update, delete: if isGlobalAdmin() || isAuthenticated();

      match /{sub=**} {
        allow read, create: if true;
        allow update, delete: if isGlobalAdmin() || isAuthenticated();
      }
    }

    match /about_reels/{reelId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();
    }

    match /about_photos/{photoId} {
      allow read: if true;
      allow write: if isGlobalAdmin() || isAuthenticated();
    }

    // 4. Tsehay Campus Application Artifacts Scope
    match /artifacts/{appId} {
      
      function isAdmin() {
        return request.auth != null && (
          (request.auth.token.admin == true) ||
          (request.auth.token.email in [
            'admin@tsehaycampus.com',
            'tsehayoperation@gmail.com',
            'eyoubsahle@gmail.com',
            'habte@gmail.com',
            'cryptomaster758@gmail.com'
          ]) ||
          exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid))
        );
      }

      // 4.1 Admins Collection
      match /admins/{userId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create, update, delete: if isAdmin() || isAuthenticated();
      }

      // 4.2 Public Data: Courses (Catalog, Lesson Details, AI System Prompts)
      match /public/data/courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAdmin() || isAuthenticated();
        }
      }

      // Legacy direct courses collection
      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAdmin() || isAuthenticated();
        }
      }

      // Direct and public events collections
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAdmin() || isAuthenticated();
        }
      }

      match /event_registrations/{regId} {
        allow read, create: if true;
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      // 4.3 Public Data: Site Settings (About Video, YouTube Portfolio, AI Settings)
      match /public/data/site_settings/{settingKey} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAdmin() || isAuthenticated();
        }
      }

      // 4.4 Public Data: YouTube Portfolio Videos
      match /public/data/youtube_videos/{videoId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      // 4.5 Public Data: Referral & Discount Codes
      match /public/data/referral_codes/{codeId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      // 4.6 Public Data: Referrals Tracker
      match /public/data/referrals/{refId} {
        allow read, write: if true;
      }

      // 4.7 Public Data: Certificates
      match /public/data/certificates/{certId} {
        allow read: if true;
        allow write: if true;
      }

      // 4.8 Public Data: About Reels & Photos
      match /public/data/about_reels/{reelId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      match /public/data/about_photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      // 4.9 Public Data: Q&A Community
      match /public/data/qa/{qaId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      // 4.9 Public Data Users Listing (Admin Access)
      match /public/data/users/{userId} {
        allow read, write: if isAdmin() || isAuthenticated();
      }

      // 4.10 General fallback for public data collections
      match /public/data/{document=**} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      // 4.11 User Private Data & Subcollections (Artifact Scope)
      match /users/{userId} {
        // User root doc
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        allow create: if isAuthenticated() || isAdmin();

        // Profile info & all nested subcollections
        match /{document=**} {
          allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
          allow create: if isAuthenticated() || isAdmin();
        }
      }

      // 4.12 Support & Helpdesk Tickets
      match /support/{document=**} {
        allow read, write: if isAdmin() || isAuthenticated();
      }

      // 4.13 Community Posts & Comments (Artifact Scope)
      match /community_posts/{postId} {
        allow read: if true;
        allow write: if isAuthenticated() || isAdmin();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAuthenticated() || isAdmin();
        }
      }

      // 4.14 Community Conversations & Direct Messages (Artifact Scope)
      match /community_conversations/{convId} {
        allow read, write: if isAuthenticated() || isAdmin();

        match /{sub=**} {
          allow read, write: if isAuthenticated() || isAdmin();
        }
      }

      // 4.15 Instructors in Artifact Scope
      match /public/data/instructors/{instructorId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }
    }
  }
}
