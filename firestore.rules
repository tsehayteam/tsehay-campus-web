rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default to prevent data leaks
    match /{document=**} {
      allow read, write: if false;
    }

    function isGlobalAdmin() {
      return request.auth != null && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'habte@gmail.com' ||
          request.auth.token.email == 'cryptomaster758@gmail.com' ||
          request.auth.token.email == 'admin@tsehaycampus.com'
        ))
      );
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }
    
    match /users/{userId} {
      allow read, write: if isGlobalAdmin() || (request.auth != null && request.auth.uid == userId);
      
      match /enrollments/{courseId} {
        allow read: if isGlobalAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if isGlobalAdmin(); // Write restricted to server/admin
      }
    }

    match /artifacts/{appId} {
      
      function isAdmin() {
        return request.auth != null && (
          (request.auth.token.admin == true) ||
          (request.auth.token.email_verified == true && (
            request.auth.token.email == 'habte@gmail.com' ||
            request.auth.token.email == 'cryptomaster758@gmail.com' ||
            request.auth.token.email == 'admin@tsehaycampus.com'
          )) ||
          exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid))
        );
      }

      // 1. Admins Collection
      match /admins/{userId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if isAdmin();
      }

      // 2. Public Data - Explicit Whitelisting
      match /public/data/courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();

        match /{sub=**} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }

      match /public/data/site_settings/{settingKey} {
        allow read: if true;
        allow write: if isAdmin() || request.auth != null;
      }

      match /public/data/youtube_videos/{videoId} {
        allow read: if true;
        allow write: if isAdmin() || request.auth != null;
      }

      match /public/data/referral_codes/{codeId} {
        allow read: if true;
        allow write: if isAdmin() || request.auth != null;
      }

      match /public/data/referrals/{refId} {
        allow read, write: if true;
      }

      match /public/data/certificates/{certId} {
        allow read: if true;
        allow write: if true;
      }

      match /public/data/qa/{qaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // Deny public read on users under public/data
      match /public/data/users/{userId} {
        allow read, write: if false;
      }

      // General fallback for public data collections
      match /public/data/{document=**} {
        allow read: if true;
        allow write: if isAdmin() || request.auth != null;
      }

      // 3. User Private Data
      match /users/{userId} {
        // User root doc
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);

        // Profile
        match /profile/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId && !('role' in request.resource.data) && !('points' in request.resource.data) && !('isAdmin' in request.resource.data));
          allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points', 'isAdmin'])));
          allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        }
        
        // Notes
        match /notes/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!('text' in request.resource.data) || request.resource.data.text.size() < 50000));
        }

        // Chat History
        match /chat/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!('text' in request.resource.data) || request.resource.data.text.size() < 10000));
        }

        // AI Chat History
        match /ai_chat/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        }

        // Gamification Progress
        match /progress/{document=**} {
          allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        }

        // Enrollments - Write restricted to Server Admin SDK or Admin
        match /purchased_courses/{courseId} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin();
        }
      }
      
    }
  }
}
