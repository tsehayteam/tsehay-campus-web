rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default to prevent data leaks
    match /{document=**} {
      allow read, write: if false;
    }

    function isGlobalAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'habte@gmail.com' ||
        request.auth.token.email == 'cryptomaster758@gmail.com' ||
        request.auth.token.email == 'admin@tsehaycampus.com'
      );
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }
    
    match /users/{userId} {
      allow read, write: if isGlobalAdmin() || (request.auth != null && request.auth.uid == userId);
      
      match /enrollments/{courseId} {
        allow read: if isGlobalAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /artifacts/{appId} {
      
      function isAdmin() {
        return request.auth != null && (
          request.auth.token.email == 'habte@gmail.com' ||
          request.auth.token.email == 'cryptomaster758@gmail.com' ||
          request.auth.token.email == 'admin@tsehaycampus.com' ||
          exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid))
        );
      }

      function getCourseData(courseId) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)).data;
      }

      function isCourseFree(courseId) {
        return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)) &&
          (
            ('price' in getCourseData(courseId) && (getCourseData(courseId).price == 0 || getCourseData(courseId).price == '0' || getCourseData(courseId).price == 'Free')) ||
            ('isFree' in getCourseData(courseId) && getCourseData(courseId).isFree == true)
          );
      }

      // 1. Admins Collection
      match /admins/{userId} {
        allow read: if isAdmin() || request.auth.uid == userId;
        allow create, update, delete: if isAdmin();
      }

      // 2. Public Data
      match /public/data/{document=**} {
        allow read: if true;
        allow write: if true; // TEMPORARY ALLOW FOR SEEDING
      }

      match /public/data/qa/{qaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // 3. User Private Data
      match /users/{userId} {
        // User root doc
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);

        // Profile
        match /profile/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId && !('role' in request.resource.data) && !('points' in request.resource.data));
          allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points'])));
          allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        }
        
        // Notes
        match /notes/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!('text' in request.resource.data) || request.resource.data.text.size() < 50000));
        }

        // Chat History
        match /chat/{document=**} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && (!('text' in request.resource.data) || request.resource.data.text.size() < 10000));
        }

        // Gamification Progress
        match /progress/{document=**} {
          allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        }

        // Enrollments - The Critical Security Lock
        match /purchased_courses/{courseId} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.amount == 0 && isCourseFree(courseId);
          allow update: if request.auth != null && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']));
          allow delete: if false;
        }
      }
      
    }
  }
}
