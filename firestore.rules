rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default to prevent data leaks
    match /{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId} {
      
      // 1. Public Data (Courses)
      match /public/data/courses/{courseId} {
        allow read: if true;
        // Only specific admin emails can create, update, or delete courses
        allow write: if request.auth != null && (
          request.auth.token.email == 'habte@gmail.com' ||
          request.auth.token.email == 'cryptomaster758@gmail.com' ||
          request.auth.token.email == 'admin@tsehaycampus.com'
        ); 
      }

      // 2. Public Data (Q&A)
      match /public/data/qa/{qaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // 3. User Private Data
      match /users/{userId} {
        // User root doc
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Profile
        match /profile/{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
        
        // Notes
        match /notes/{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Chat History
        match /chat/{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Gamification Progress
        match /progress/{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Enrollments - The Critical Security Lock
        match /enrollments/{courseId} {
          // Users can see their own enrollments
          allow read: if request.auth != null && request.auth.uid == userId;
          
          // Users can ONLY create an enrollment locally if the course is free!
          // Paid courses must be enrolled via Webhook (which uses admin SDK and bypasses these rules).
          allow create: if request.auth != null && request.auth.uid == userId
            && (
              get(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)).data.price == 0
              || get(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)).data.price == "0"
              || get(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)).data.price == ""
              || !('price' in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/courses/$(courseId)).data)
            );

          // Allow users to update metadata like last accessed time
          allow update: if request.auth != null && request.auth.uid == userId;
          
          // Users cannot delete their enrollments to prevent accidental loss
          allow delete: if false;
        }
      }
      
    }
  }
}
