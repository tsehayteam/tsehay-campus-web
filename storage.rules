rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public files (e.g. logos, public thumbnails)
    match /public/{allPaths=**} {
      allow read: if true;
    }

    // User's own directory (Private files, profile pics)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Courses directory
    // NOTE: Ideally, use Custom Claims or Signed URLs to restrict by enrollment. 
    // For now, restrict to authenticated users only (prevents public scraping).
    match /courses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only Admin SDK or Firebase Console can upload courses
    }
    
    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
