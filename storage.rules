rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for all files (like course thumbnails, profile pictures)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow users to upload to their own directory, restricted to images under 5MB
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Only admins should write to courses. To enforce this securely via client, 
    // ideally use custom claims. Since we can't easily check Firestore from Storage 
    // without custom claims, we should either block client writes entirely
    // or rely on Admin SDK (which bypasses these rules).
    match /courses/{allPaths=**} {
      allow write: if false; // All course uploads MUST go through Admin SDK or Firebase Console
    }
    
    // Explicit deny for any other writes
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
